# Run at EVERY build (custom target dp5_version): writes version_info.hpp with the release version, git describe,
# compiler and flags. The file is only replaced when its content changes, so an unchanged tree does not recompile.
# Inputs (-D): SRC_DIR (code_diagrammatics), VERSION_FILE, OUT, COMPILER, FLAGS.
file(READ "${VERSION_FILE}" _ver)
string(STRIP "${_ver}" _ver)
set(_desc "nogit")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" describe --always --dirty
                  WORKING_DIRECTORY "${SRC_DIR}" OUTPUT_VARIABLE _d RESULT_VARIABLE _r
                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(_r EQUAL 0 AND NOT "${_d}" STREQUAL "")
    set(_desc "${_d}")
  endif()
endif()
set(_txt "// generated by cmake/gen_version.cmake -- do not edit\n#pragma once\n")
string(APPEND _txt "#define DP5_RELEASE_VERSION \"${_ver}+${_desc}\"\n")
string(APPEND _txt "#define DP5_GIT_DESCRIBE \"${_desc}\"\n")
string(APPEND _txt "#define DP5_COMPILER \"${COMPILER}\"\n")
string(APPEND _txt "#define DP5_BUILD_FLAGS \"${FLAGS}\"\n")
set(_old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT "${_old}" STREQUAL "${_txt}")
  file(WRITE "${OUT}" "${_txt}")
endif()
