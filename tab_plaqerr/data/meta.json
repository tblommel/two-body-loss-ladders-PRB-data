   }
  },
  "table.csv": {
   "description": "cells of Table tab:plaqerr: err_N averaged over the five gamma (ic = initial state) or over all trajectories of the method (ic = mean); early-stopped runs excluded",
   "columns": {
    "method": "data label",
    "ic": "initial state or mean",
    "err_N": "mean err_N [1]",
    "n_runs": "trajectories averaged",
    "n_excluded": "trajectories excluded (stopped early)"
   }
